VITE_API_URL=https://liftryt-backend.onrender.com

# Same Firebase project as dev — these are public, client-safe identifiers
# (protected by Firebase's own API key restrictions / security rules, not
# secrecy), so reusing frontend/.env's values here is expected, not a leak.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
