APP_NAME=LiftRyt AI
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Dev-only default in code if unset — generate a real secret for anything
# beyond local dev, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI coach LLM provider — "groq" (free tier, fast, needs an API key from
# console.groq.com) or "ollama" (fully local, no account, needs Ollama
# running with a tool-capable model pulled: `ollama pull llama3.2`).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
