APP_NAME=LiftRyt AI
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Dev-only default in code if unset — generate a real secret for anything
# beyond local dev, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI coach LLM provider — "openrouter" (free-tier model, needs an API key
# from openrouter.ai/keys) or "ollama" (fully local, no account, needs
# Ollama running with a tool-capable model pulled: `ollama pull llama3.2`).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Google Sign-In — the Firebase project ID (Project settings > General),
# used only as the expected audience when verifying a client's ID token.
FIREBASE_PROJECT_ID=

# Base URL the browser can reach the backend at — used to build absolute
# URLs for uploaded avatars. Change this to your real domain in production.
BACKEND_PUBLIC_URL=http://localhost:8000
